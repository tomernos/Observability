@Library('jenkins-shared-library') _

pipeline {
    agent {
        docker {
            image 'debian:bookworm-slim'
            args '-v /var/run/docker.sock:/var/run/docker.sock -u root'
        }
    }

    options {
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        AWS_REGION = 'eu-central-1'
        AWS_CREDENTIALS_ID = 'aws-creds'
        CLUSTER_NAME = 'tnt-eu-observability-dev-eks'
        
        // Terraform state backend
        TF_STATE_BUCKET = 'tnt-eu-observability-dev-tf'
        TF_STATE_KEY = 'tnt-eu-observability-dev-tf.tfstate'
        TF_STATE_REGION = 'eu-central-1'
        TF_LOCK_TABLE = 'tnt-eu-observability-dev-tf-locks'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                script {
                    logMessage('Cleaning workspace', '🧹')
                    // Clean workspace and also manually remove any Terraform cache at workspace root
                    cleanWs()
                    sh '''
                        # Also manually clean any Terraform files that might persist
                        echo "🧹 Additional cleanup of Terraform cache files..."
                        find . -name ".terraform" -type d -exec rm -rf {} + 2>/dev/null || true
                        find . -name ".terraform.lock.hcl" -type f -delete 2>/dev/null || true
                        find . -name ".terraform.lock.hcl.backup" -type f -delete 2>/dev/null || true
                        echo "✅ Workspace cleaned"
                    '''
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    // Checkout this repository (Observability)
                    checkout scm
                    
                    // Verify no lock files were checked out
                    sh '''
                        echo "🔍 Checking for any Terraform lock files after checkout..."
                        if find . -name ".terraform.lock.hcl" -type f | grep -q .; then
                            echo "⚠️  WARNING: Found .terraform.lock.hcl files in repository!"
                            find . -name ".terraform.lock.hcl" -type f
                            echo "Removing them..."
                            find . -name ".terraform.lock.hcl" -type f -delete
                        else
                            echo "✅ No lock files found in repository"
                        fi
                    '''
                }
            }
        }

        stage('Install Tools') {
            steps {
                script {
                    logMessage('Installing required tools', '📦')
                    
                    sh '''
                        set -e
                        apt-get update -qq
                        apt-get install -y -qq curl unzip wget ca-certificates gnupg lsb-release
                        
                        # Install Terraform
                        TERRAFORM_VERSION=1.14.3
                        wget -q https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
                        unzip terraform_${TERRAFORM_VERSION}_linux_amd64.zip -d /usr/local/bin
                        rm terraform_${TERRAFORM_VERSION}_linux_amd64.zip
                        chmod +x /usr/local/bin/terraform
                        
                        # Install AWS CLI v2
                        if ! command -v aws &> /dev/null; then
                            echo "📦 Installing AWS CLI v2..."
                            curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
                            unzip -q awscliv2.zip
                            ./aws/install
                            rm -rf awscliv2.zip aws
                            echo "✅ AWS CLI installed"
                        else
                            echo "✅ AWS CLI already installed"
                        fi
                        
                        # Cleanup
                        apt-get clean
                        rm -rf /var/lib/apt/lists/*
                        
                        # Verify tools
                        echo "🔍 Verifying installed tools..."
                        terraform version
                        aws --version
                        echo "✅ All tools installed successfully"
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    logMessage('Initializing Terraform', '🔧')
                    
                    withCredentials([usernamePassword(
                        credentialsId: AWS_CREDENTIALS_ID,
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )]) {
                        dir('infra-tf') {
                            sh """
                                set -e  # Exit on error
                                
                                # Verify Terraform files exist
                                echo "🔍 Verifying Terraform configuration files..."
                                echo "Current directory: \$(pwd)"
                                if [ ! -f "main.tf" ]; then
                                    echo "❌ Error: main.tf not found in infra-tf"
                                    echo "Files in directory:"
                                    ls -la
                                    exit 1
                                fi
                                echo "✅ Found main.tf"
                                
                                # Verify module source is using registry (not git)
                                echo "🔍 Verifying module source configuration in main.tf..."
                                if grep -q 'git::.*vpc' main.tf; then
                                    echo "❌ ERROR: Found git source in main.tf!"
                                    grep 'git::.*vpc' main.tf
                                    exit 1
                                fi
                                if ! grep -q 'terraform-aws-modules/vpc/aws' main.tf; then
                                    echo "❌ ERROR: VPC module source not found in main.tf!"
                                    exit 1
                                fi
                                echo "✅ Module source verified (using Terraform Registry)"
                                echo ""
                                
                                # Aggressively clear any cached Terraform files
                                echo "🧹 Aggressively cleaning Terraform cache..."
                                echo "Before cleanup - checking for cache files:"
                                ls -la .terraform 2>/dev/null || echo "No .terraform directory"
                                ls -la .terraform.lock.hcl 2>/dev/null || echo "No .terraform.lock.hcl file"
                                
                                # Remove all Terraform cache files
                                rm -rf .terraform .terraform.lock.hcl .terraform.lock.hcl.backup
                                find . -name ".terraform" -type d -exec rm -rf {} + 2>/dev/null || true
                                find . -name ".terraform.lock.hcl" -type f -delete 2>/dev/null || true
                                find . -name ".terraform.lock.hcl.backup" -type f -delete 2>/dev/null || true
                                
                                echo "After cleanup - verifying cache is removed:"
                                if [ -d ".terraform" ] || [ -f ".terraform.lock.hcl" ]; then
                                    echo "⚠️  WARNING: Cache files still exist!"
                                    ls -la .terraform 2>/dev/null || true
                                    ls -la .terraform.lock.hcl 2>/dev/null || true
                                else
                                    echo "✅ Cache cleared successfully"
                                fi
                                echo ""
                                
                                # Show module source from main.tf to confirm
                                echo "📋 VPC module source from main.tf:"
                                grep -A 3 'module "vpc"' main.tf | grep -E '(source|version)' || true
                                echo ""
                                
                                # Check available versions from registry (for debugging)
                                echo "🔍 Checking available VPC module versions from registry..."
                                terraform init -upgrade -backend=false 2>&1 | grep -i "vpc" | head -5 || echo "Version check completed"
                                echo ""
                                
                                echo "🔧 Initializing Terraform with S3 backend (fresh download from registry)..."
                                terraform init \\
                                    -upgrade \\
                                    -reconfigure \\
                                    -backend-config="bucket=${TF_STATE_BUCKET}" \\
                                    -backend-config="key=${TF_STATE_KEY}" \\
                                    -backend-config="region=${TF_STATE_REGION}" \\
                                    -backend-config="dynamodb_table=${TF_LOCK_TABLE}"
                                
                                echo ""
                                echo "✅ Terraform initialized successfully"
                                
                                # Verify lock file was created with registry source
                                if [ -f ".terraform.lock.hcl" ]; then
                                    echo "🔍 Verifying lock file uses registry (not git)..."
                                    if grep -q "registry.terraform.io/terraform-aws-modules/vpc/aws" .terraform.lock.hcl; then
                                        echo "✅ Lock file correctly uses Terraform Registry"
                                    elif grep -q "git::" .terraform.lock.hcl; then
                                        echo "❌ ERROR: Lock file still contains git source!"
                                        grep "git::" .terraform.lock.hcl | head -5
                                        exit 1
                                    fi
                                fi
                            """
                        }
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                script {
                    logMessage('Validating Terraform configuration', '✅')
                    
                    withCredentials([usernamePassword(
                        credentialsId: AWS_CREDENTIALS_ID,
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )]) {
                        dir('infra-tf') {
                            sh '''
                                # Verify directory and files
                                echo "Current directory: $(pwd)"
                                if [ ! -f "main.tf" ]; then
                                    echo "❌ Error: main.tf not found!"
                                    echo "Directory contents:"
                                    ls -la
                                    exit 1
                                fi
                                echo "✅ Found main.tf"
                                
                                terraform fmt -check -diff || true
                                terraform validate
                                echo "✅ Terraform configuration is valid"
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    logMessage('Running Terraform plan', '📋')
                    
                    withCredentials([usernamePassword(
                        credentialsId: AWS_CREDENTIALS_ID,
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )]) {
                        dir('infra-tf') {
                            sh '''
                                # Verify directory and files
                                echo "Current directory: $(pwd)"
                                if [ ! -f "main.tf" ]; then
                                    echo "❌ Error: main.tf not found!"
                                    echo "Directory contents:"
                                    ls -la
                                    exit 1
                                fi
                                echo "✅ Found main.tf"
                                
                                export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                                export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                                export AWS_DEFAULT_REGION=eu-central-1
                                
                                echo "🔍 Running terraform plan..."
                                terraform plan -out=tfplan
                                echo "✅ Terraform plan completed"
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                script {
                    logMessage('Applying Terraform changes', '🚀')
                    
                    withCredentials([usernamePassword(
                        credentialsId: AWS_CREDENTIALS_ID,
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )]) {
                        dir('infra-tf') {
                            sh '''
                                export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                                export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                                export AWS_DEFAULT_REGION=eu-central-1
                                
                                echo "🚀 Applying Terraform changes..."
                                terraform apply -auto-approve tfplan
                                echo "✅ Terraform apply completed"
                            '''
                        }
                    }
                }
            }
        }

        stage('Output Cluster Info') {
            steps {
                script {
                    logMessage('Retrieving cluster information', '📊')
                    
                    withCredentials([usernamePassword(
                        credentialsId: AWS_CREDENTIALS_ID,
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )]) {
                        dir('infra-tf') {
                            sh '''
                                export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                                export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                                export AWS_DEFAULT_REGION=eu-central-1
                                
                                echo "📊 Cluster Information:"
                                terraform output -json || echo "⚠️  No outputs available yet"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "🏁 Infrastructure pipeline completed"
            }
        }
        success {
            script {
                echo "✅ Infrastructure pipeline succeeded"
            }
        }
        failure {
            script {
                echo "❌ Infrastructure pipeline failed"
            }
        }
    }
}

