# =============================================================================
# GitIgnore for Observability Repository
# Protects sensitive data, secrets, and environment-specific files
# =============================================================================

# =============================================================================
# SECRETS AND SENSITIVE DATA
# =============================================================================

# SSH Keys (private keys should NEVER be committed)
**/*_rsa
**/*_rsa.pub
**/*_ed25519
**/*_ed25519.pub
**/*_ecdsa
**/*_ecdsa.pub
**/.ssh/
**/ssh_keys/
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx

# Kubernetes Secrets (raw secret files)
**/secrets/
**/*-secret.yaml
**/*secret*.yaml
**/*_secret.yaml
# Exception: template/example secrets are OK
!**/*-secret.yaml.example
!**/*-secret.yaml.template
!**/*-secret.yaml.tpl

# ArgoCD Repository Secrets with real keys
gitops/infrastructure/argocd/repository-secret.yaml
gitops/**/repository-secret.yaml

# Environment files with sensitive data
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
**/config.local.*
**/secrets.yaml
**/secrets.yml

# =============================================================================
# TERRAFORM SENSITIVE FILES
# =============================================================================

# Terraform state files (contain sensitive data)
**/*.tfstate
**/*.tfstate.*
**/*.tfstate.backup
**/terraform.tfstate*
**/crash.log
**/crash.*.log

# Terraform variable files with secrets
#**/*.auto.tfvars
**/*secret*.tfvars
**/*secrets*.tfvars
**/terraform.tfvars
# Exception: example/template tfvars are OK
!**/*.tfvars.example
!**/*.tfvars.template

# Terraform plans (may contain sensitive data)
**/*.tfplan
**/plan.out
**/plan.json

# Terraform provider plugins and cache
**/.terraform/
**/.terraform.lock.hcl
**/terraform.rc
**/.terraformrc

# =============================================================================
# KUBERNETES AND ARGOCD SENSITIVE FILES
# =============================================================================

# Kubeconfig files (contain cluster access credentials)
**/kubeconfig*
**/.kube/config*
**/.kube/cache/
**/kube-config*
**/config.yaml

# ArgoCD generated files
**/argocd-*-password
**/argocd-admin-password
**/argocd-server.crt
**/argocd-server.key

# Helm values with secrets
**/*secret*values*.yaml
**/*secrets*values*.yaml
**/values-secret*.yaml
**/values-secrets*.yaml
# Exception: template files are OK
!**/*values*.yaml.example
!**/*values*.yaml.template

# =============================================================================
# CLOUD PROVIDER CREDENTIALS
# =============================================================================

# AWS credentials
**/.aws/credentials
**/.aws/config
**/aws-credentials
**/credentials.csv
**/*credentials*.json

# Azure credentials
**/.azure/
**/azureProfile.json

# Google Cloud credentials
**/gcloud/
**/*service-account*.json
**/*serviceaccount*.json
**/application_default_credentials.json

# =============================================================================
# DEVELOPMENT AND BUILD FILES
# =============================================================================

# IDE and editor files
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
**/*.log
**/logs/
**/log/

# Temporary files
**/*.tmp
**/*.temp
**/tmp/
**/temp/
**/.cache/

# Node.js (if using any Node tools)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.npm
**/.yarn

# Python (if using any Python tools)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/venv/
**/env/
**/.env

# =============================================================================
# PERSONAL AND LOCAL FILES
# =============================================================================

# Personal notes and scratch files
**/notes.md
**/TODO.md
**/scratch.*
**/test.*
**/debug.*
**/personal/
askchat.txt

# Local configuration overrides
**/*.local
**/local.*
**/local/

# Backup files
**/*.bak
**/*.backup
**/*.orig

# =============================================================================
# GENERATED AND COMPILED FILES
# =============================================================================

# Compiled binaries
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# Archives
**/*.zip
**/*.tar.gz
**/*.rar

# =============================================================================
# EXCEPTIONS (files that should be tracked despite patterns above)
# =============================================================================

# Template and example files should be tracked
!**/*.example
!**/*.template
!**/*.tpl
!**/*-template.*
!**/*-example.*

# Documentation - Ignore general .md files, but keep important docs
# First ignore all .md files
**/*.md
# Then un-ignore important documentation files
!README.md
!**/README.md
!**/GUIDE*.md
!**/SETUP*.md
!**/QUICK*.md
!**/INDEX*.md
!**/CHANGELOG*.md

# Public keys in specific contexts (deployment keys, etc.)
!**/deploy-key.pub
!**/public-key.pub

# =============================================================================
# PROJECT SPECIFIC EXCLUSIONS
# =============================================================================

# Keep example configurations
!gitops/**/example-*
!infra-tf/**/example-*
!helm/**/example-*

# Keep documentation and templates
!**/*-template.yaml
!**/*-example.yaml
!**/README*
!**/GUIDE*
